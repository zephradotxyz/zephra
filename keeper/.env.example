# Zephra keeper: copy to keeper/.env and fill in.
RPC_URL=https://node.eleos.fun
# Optional private RPC (tried first, and used by the /rpc read proxy so the key never reaches the browser)
DRPC_URL=
# Dedicated hot wallet for the keeper. Fund it with a little HYPE for gas.
# Never reuse the deployer or admin key. Never commit this file.
KEEPER_PK=0x
DEPLOYMENT=../contracts/deployments/elysiumMainnetV4.json
POLL_MS=5000
PORT=8787
# IPFS metadata uploads (optional): IPFS_PROVIDER=pinata + PINATA_JWT, or IPFS_PROVIDER=local
IPFS_PROVIDER=local
