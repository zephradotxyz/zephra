# ── Zephra · ELYSIUM MAINNET · copy to contracts/.env ──
# Fill ONLY with values from Kinetiq's official channels (elysium.kinetiq.xyz, x.com/Enter_Elysium).
# Never use an RPC from a random site or "community bridge": it can feed you fake data.

# Official Elysium mainnet RPC (published at launch).
ELYSIUM_MAINNET_RPC=
# Expected chain ID. 99901 unless Kinetiq announces otherwise. The deploy aborts if the RPC disagrees.
ELYSIUM_MAINNET_CHAIN_ID=99901
# Official Elysium mainnet explorer base URL (written into the app build).
EXPLORER_URL=

# Deployer hot wallet (pays ~0.05 HYPE gas). It does NOT keep any power if ADMIN/GUARDIAN/TREASURY are other addresses.
DEPLOYER_PK=0x

# Roles — REQUIRED on mainnet. Use a multisig (e.g. Safe on Elysium) for ADMIN and TREASURY.
ADMIN=
GUARDIAN=
TREASURY=

# Economics (HYPE). G = what a curve must raise to graduate (1 – 1,000,000). Creation fee ≤ 10.
GRAD_TARGET=
CREATION_FEE=

# Public URL of the keeper/API as the browser sees it ("/keeper" when served by the bundled Caddy).
PUBLIC_API_URL=/keeper
# Public IPFS gateway used as a fallback when the API is unreachable.
IPFS_GATEWAY=https://ipfs.io/ipfs/

# Final safety switch: the deploy script refuses mainnet until this says yes.
CONFIRM_MAINNET=no
